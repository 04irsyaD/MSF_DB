# ============================================================
# MSF-DB v2 — Environment Variables
# ============================================================
# Salin file ini:  cp .env.example .env
# Jangan commit file .env ke Git!
#
# Port v2 sengaja dibedakan dari msf-app (v1) agar keduanya dapat
# berjalan bersamaan untuk dibandingkan.
# ============================================================

# ------------------------------------------------------------
# PORT DAN ALAMAT (v2)
# ------------------------------------------------------------

# Port backend FastAPI (msf-app berjalan di 8080)
BACKEND_PORT=8001

# Port frontend Next.js.
# 3001 sudah dipakai msf-frontend dan 5433 dipakai proyek lain di mesin ini,
# sehingga angka di bawah dipilih dari yang benar-benar kosong.
FRONTEND_PORT=3002

# Alamat backend yang dipakai browser
NEXT_PUBLIC_API_URL=http://localhost:8001

# Allowed CORS origins (pisah koma jika lebih dari satu)
CORS_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

# ------------------------------------------------------------
# OLLAMA (AI LOKAL)
# ------------------------------------------------------------

# URL Ollama service. Ollama dijalankan di host, bukan sebagai container.
# Memakai port yang SAMA dengan msf-app (11434) dan itu memang benar: Ollama
# adalah layanan yang dikonsumsi lewat HTTP, bukan yang di-bind v2, sehingga
# dua aplikasi boleh menunjuk instance yang sama tanpa bentrok.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Model default yang dipakai
# CATATAN: variabel ini TIDAK dibaca kode mana pun saat ini.
OLLAMA_DEFAULT_MODEL=llama3.2

# Timeout request ke Ollama (detik)
OLLAMA_TIMEOUT=300

# ------------------------------------------------------------
# CLOUD AI PROVIDER (Opsional)
# ------------------------------------------------------------

# DeepSeek API Key (isi jika mau pakai DeepSeek)
DEEPSEEK_API_KEY=

# DeepSeek API URL
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# DeepSeek Model default
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# Timeout request ke DeepSeek (detik)
DEEPSEEK_TIMEOUT=120

# OpenAI API Key (isi jika mau pakai OpenAI)
OPENAI_API_KEY=

# OpenAI Model default
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Timeout request ke OpenAI (detik)
OPENAI_TIMEOUT=120

# ------------------------------------------------------------
# GENERATE SETTINGS DEFAULT
# ------------------------------------------------------------

# Bahasa output default: Indonesian | English
DEFAULT_LANGUAGE=Indonesian

# Level detail default: simple | detailed | comprehensive
DEFAULT_DETAIL_LEVEL=detailed

# Maksimal tabel yang bisa diproses dalam satu request
MAX_TABLES_PER_REQUEST=50

# ------------------------------------------------------------
# BACKGROUND JOB DAN PERSISTENSI (v2.2.0)
# ------------------------------------------------------------

# Lokasi basis data SQLite berisi riwayat job.
# Berada di dalam volume backend_outputs agar ikut ter-backup bersamanya.
JOBS_DB_PATH=/app/outputs/jobs.db

# Umur BERKAS hasil di disk, dalam menit.
# Setelah lewat, berkas dihapus tetapi baris riwayatnya TETAP ADA,
# sehingga kode akses masih dapat dilacak dan dijawab 410 RESULT_EXPIRED.
MAX_JOB_RETENTION_MINUTES=60

# Umur BARIS riwayat job, dalam hari. Setelah lewat, barisnya dihapus
# dan kode akses menjadi 404.
JOB_RECORD_RETENTION_DAYS=30

# Maksimal job yang bisa berjalan bersamaan
MAX_CONCURRENT_JOBS=3

# Batas waktu satu pekerjaan (detik). Lewat dari ini job dihentikan.
JOB_TIMEOUT_SECONDS=1800

# ------------------------------------------------------------
# RATE LIMITING PER IP (v2.2.0)
# ------------------------------------------------------------

# Matikan dengan false sebagai jalan keluar cepat saat insiden.
RATE_LIMIT_ENABLED=true

# Batas untuk POST /api/generate/from-ddl dan /api/generate/from-db
RATE_LIMIT_GENERATE=10/minute

# Batas untuk POST /api/admin/verify
RATE_LIMIT_ADMIN_VERIFY=5/minute

# Nyalakan HANYA bila backend berada di belakang proxy tepercaya.
# Header X-Forwarded-For dapat dipalsukan klien: memercayainya tanpa proxy
# tepercaya membuat rate limit dapat dilewati sepenuhnya.
RATE_LIMIT_TRUST_FORWARDED_FOR=false

# ------------------------------------------------------------
# DATABASE CONNECTIONS (untuk testing lokal)
# ------------------------------------------------------------

# PostgreSQL lokal (service docker-compose)
# CATATAN: variabel ini TIDAK dibaca kode mana pun saat ini.
TEST_POSTGRES_URL=postgresql://msf_user:msf_password@postgres:5432/msf_test

# ------------------------------------------------------------
# SQL SERVER (v2.2.0)
# ------------------------------------------------------------

# Nama driver ODBC di dalam image backend.
MSSQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Validasi sertifikat server SQL Server.
# Biarkan "no" agar sertifikat benar-benar diperiksa. Setel "yes" HANYA untuk
# server dengan sertifikat self-signed yang Anda kendalikan sendiri, dan sadari
# konsekuensinya: driver akan menerima sertifikat apa pun, sehingga kredensial
# database dapat disadap oleh penyerang di jalur jaringan.
MSSQL_TRUST_SERVER_CERTIFICATE=no

# ------------------------------------------------------------
# POSTGRESQL SERVICE (Docker Compose internal)
# ------------------------------------------------------------
# Ini database CONTOH untuk menguji fitur koneksi database,
# BUKAN tempat penyimpanan data aplikasi.

POSTGRES_DB=msf_test
POSTGRES_USER=msf_user
POSTGRES_PASSWORD=msf_password
POSTGRES_PORT=5434

# ------------------------------------------------------------
# EXPORT SETTINGS
# ------------------------------------------------------------

# Direktori tempat menyimpan file hasil generate (di dalam container)
OUTPUT_DIR=/app/outputs

# Direktori template Word (di dalam container)
TEMPLATES_DIR=/app/templates

# Direktori data shortcut SQL (di dalam container)
SHORTCUTS_DIR=/app/shortcuts_data

# CATATAN: dua variabel di bawah TIDAK dibaca kode mana pun saat ini.
MAX_OUTPUT_SIZE_MB=50
DEFAULT_OUTPUT_FORMAT=docx

# ------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------

# Lokasi file log yang dibaca Admin Portal
LOG_FILE_PATH=/app/outputs/app.log

# CATATAN: dua variabel di bawah TIDAK dibaca kode mana pun saat ini.
LOG_LEVEL=INFO
LOG_FORMAT=text

# ------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------

# Passcode Admin Portal.
# WAJIB diisi agar /admin berfungsi. Selama KOSONG, seluruh endpoint
# admin menjawab 403 dan portal mati total. Tidak ada nilai default.
ADMIN_PASSCODE=

# API Key untuk proteksi endpoint
# Kosongkan untuk development mode (tanpa autentikasi)
# Isi dengan string random panjang untuk production, contoh: openssl rand -hex 32
MSF_API_KEY=

# ------------------------------------------------------------
# CLOUDFLARE TUNNEL
# ------------------------------------------------------------

# RAHASIA. Wajib diisi bila layanan cloudflared dipakai; tanpa ini
# container cloudflared gagal start dengan pesan yang tidak menjelaskan
# penyebabnya. Ambil token dari dashboard Cloudflare Zero Trust.
CLOUDFLARE_TUNNEL_TOKEN=

# ------------------------------------------------------------
# CATATAN VARIABEL MATI
# ------------------------------------------------------------
# SECRET_KEY sengaja DIHAPUS dari file ini dan dari docker-compose.yml:
# tidak ada satu pun kode yang membacanya, sehingga keberadaannya hanya
# menyesatkan operator.
#
# Variabel berikut terdokumentasi di atas tetapi belum dibaca kode mana pun:
# OLLAMA_DEFAULT_MODEL, TEST_POSTGRES_URL, MAX_OUTPUT_SIZE_MB,
# DEFAULT_OUTPUT_FORMAT, LOG_LEVEL, LOG_FORMAT.
