# ============================================================
# MSF-APP — Environment Variables
# ============================================================
# Salin file ini:  cp .env.example .env
# Jangan commit file .env ke Git!
# ============================================================

# ------------------------------------------------------------
# BACKEND CONFIG
# ------------------------------------------------------------

# Port backend FastAPI
BACKEND_PORT=8000

# Port frontend Next.js
FRONTEND_PORT=3000

# Secret key untuk signing (ganti dengan string random panjang)
SECRET_KEY=change-this-to-a-random-secret-key-min-32-chars

# Allowed CORS origins (pisah koma jika lebih dari satu)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------
# OLLAMA (AI LOKAL)
# ------------------------------------------------------------

# URL Ollama service
# Pakai "http://ollama:11434" jika run via docker-compose
# Pakai "http://localhost:11434" jika Ollama run manual di host
OLLAMA_BASE_URL=http://ollama:11434

# Model default yang dipakai
# Rekomendasi: llama3.2 (ringan), llama3.1:8b (lebih akurat)
OLLAMA_DEFAULT_MODEL=llama3.2

# Timeout request ke Ollama (detik)
OLLAMA_TIMEOUT=300

# ------------------------------------------------------------
# CLOUD AI PROVIDER (Opsional)
# ------------------------------------------------------------

# DeepSeek API Key (isi jika mau pakai DeepSeek)
DEEPSEEK_API_KEY=

# DeepSeek API URL
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# DeepSeek Model default
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# OpenAI API Key (isi jika mau pakai OpenAI)
OPENAI_API_KEY=

# OpenAI Model default
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# ------------------------------------------------------------
# GENERATE SETTINGS DEFAULT
# ------------------------------------------------------------

# Bahasa output default: Indonesian | English
DEFAULT_LANGUAGE=Indonesian

# Level detail default: simple | detailed | comprehensive
DEFAULT_DETAIL_LEVEL=detailed

# Maksimal tabel yang bisa diproses dalam satu request
MAX_TABLES_PER_REQUEST=50

# ------------------------------------------------------------
# BACKGROUND JOB
# ------------------------------------------------------------

# Berapa lama (menit) job disimpan di memory setelah selesai
MAX_JOB_RETENTION_MINUTES=60

# Maksimal job yang bisa berjalan bersamaan
MAX_CONCURRENT_JOBS=3

# ------------------------------------------------------------
# DATABASE CONNECTIONS (untuk testing lokal)
# ------------------------------------------------------------

# PostgreSQL lokal (service docker-compose)
TEST_POSTGRES_URL=postgresql://msf_user:msf_password@postgres:5432/msf_test

# PostgreSQL host (jika run manual)
# TEST_POSTGRES_URL=postgresql://msf_user:msf_password@localhost:5432/msf_test

# ------------------------------------------------------------
# POSTGRESQL SERVICE (Docker Compose internal)
# ------------------------------------------------------------

POSTGRES_DB=msf_test
POSTGRES_USER=msf_user
POSTGRES_PASSWORD=msf_password
POSTGRES_PORT=5432

# ------------------------------------------------------------
# EXPORT SETTINGS
# ------------------------------------------------------------

# Direktori tempat menyimpan file hasil generate (di dalam container)
OUTPUT_DIR=/app/outputs

# Maksimal ukuran file output (MB)
MAX_OUTPUT_SIZE_MB=50

# Format output default: docx | pdf (pdf tersedia di v2.2)
DEFAULT_OUTPUT_FORMAT=docx

# ------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------

# Level logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Format log: json | text
LOG_FORMAT=text
